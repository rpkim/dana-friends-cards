# Google Gemini (Generative Language API)
# Set locally in .env.local — never commit real keys.
GOOGLE_GENERATIVE_AI_API_KEY=
# Alias also accepted by the app:
GEMINI_API_KEY=

# Style-direction model (text/vision). Prefer Flash.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STYLE_FALLBACK_MODEL=gemini-3.5-flash

# Image model for photo stylize / regenerate / parts remix (mandated).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional extras only — leave empty to use the primary model alone (no silent roaming).
# GEMINI_IMAGE_FALLBACK_MODELS=
