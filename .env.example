# Google Gemini (Generative Language API)
# Set locally in .env.local — never commit real keys.
GOOGLE_GENERATIVE_AI_API_KEY=
# Alias also accepted by the app:
GEMINI_API_KEY=

# Style-direction model (text/vision). Gemini 4 Argon does not emit image pixels.
GEMINI_MODEL=gemini-4-argon

# Image-emitting model used for frame art + photo stylization.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
